{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CafeHelp",
  "version": "0.1.0",
  "identifier": "ru.cafehelp.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CafeHelp",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8080 ws://localhost:3000; img-src 'self' data: blob: http://localhost:8080; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": null,
      "capabilities": ["default", "child-windows"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../desktop/runtime/*": "runtime/",
      "../../desktop/runtime/images/*": "runtime/images/",
      "resources/printer-drivers/*": "printer-drivers/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
